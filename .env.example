# Trader LLM (SpaceXAI / xAI, OpenAI-compatible). Required by run_live.py unless you pass
# --mock-llm. Model and base URL for the Trader live in config/settings.yaml (llm.*),
# and LLM_BASE_URL / LLM_MODEL / LLM_API_KEY override them without editing the file.
XAI_API_KEY=

# AgentRouter (agentrouter.to) as the Trader's provider. It is not OpenAI-compatible, so
# the base URL alone is what selects the adapter in trader/agentrouter.py; the OpenAI
# client cannot reach it. Calls are billed in prepaid credits, quoted per request.
#   LLM_BASE_URL=https://api.agentrouter.to/api/agentic-api
#   LLM_MODEL=openai/gpt-oss-120b
#   LLM_ROUTE_KEY=models.chat.complete.groq.mpp   # pins one provider route; omit to let
#                                                 # AgentRouter choose from its own
#   LLM_PROVIDER=groq                             # optional, with allowFallback on
# Routes and their models: /api/agentic-api/domains/models/capabilities/chat-complete/routes
AGENTIC_API_KEY=

# Optional: a separate model for the A5 adaptive attacker (defaults to the xAI key above)
ATTACKER_API_KEY=
ATTACKER_BASE_URL=https://api.x.ai/v1
ATTACKER_MODEL=grok-4.5

# Bitget demo keys. Fills follow execution.fills in config/settings.yaml, not these keys:
# with fills=sim (the default) the book is simulated on public candles whatever is set here.
# These are what scripts/check_bitget_demo.py and fills=bitget-demo use.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Optional sentiment
CRYPTOPANIC_TOKEN=

# Runtime. TARE_DB is read by run_live.py, run_attacks.py, export_results.py and the dashboard.
TARE_DB=data/tare.db
PAPER_EQUITY=10000
