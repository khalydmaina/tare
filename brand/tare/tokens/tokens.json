{
  "name": "Tare",
  "version": "1.1.0",
  "meta": {
    "product": "Tare",
    "hackathon": "Bitget AI × Crypto Hackathon, Genesis Season 2",
    "tone": "Forensic, severe, honest, monochrome",
    "metaphor": "Tare weight — zero the empty scale to read true net measurement"
  },
  "color": {
    "bg.canvas": { "hex": "#0A0A0A", "role": "App / page background" },
    "bg.panel": { "hex": "#111111", "role": "Cards, chart plot area" },
    "bg.panel-elevated": { "hex": "#161616", "role": "Hover / selected rows" },
    "border.subtle": { "hex": "#222222", "role": "Dividers, chart grid" },
    "border.strong": { "hex": "#333333", "role": "Focus rings (non-danger)" },
    "text.primary": { "hex": "#F0F0F0", "role": "Body" },
    "text.muted": { "hex": "#A3A3A3", "role": "Labels, captions" },
    "text.inverse": { "hex": "#0A0A0A", "role": "Text on light buttons only" },
    "accent.guarded": { "hex": "#22C55E", "role": "Guarded equity, approve, held" },
    "accent.danger": { "hex": "#EF4444", "role": "Shadow equity, veto, harm" },
    "accent.danger-deep": { "hex": "#7F1D1D", "role": "Veto flash background" },
    "accent.neutral": { "hex": "#FFFFFF", "role": "Primary UI chrome, gauges, bars" }
  },
  "type": {
    "display": { "family": "Poppins", "fallback": "Montserrat, Helvetica Neue, Arial, sans-serif", "weight": 700, "tracking": "-0.02em" },
    "ui": { "family": "IBM Plex Sans", "fallback": "Inter, Helvetica Neue, Arial, sans-serif", "weight": 400 },
    "mono": { "family": "IBM Plex Mono", "fallback": "JetBrains Mono, ui-monospace, monospace", "weight": 400 },
    "scale": {
      "display": "32-40px",
      "section": "20-24px",
      "body": "14-16px",
      "meta": "12-13px"
    }
  },
  "shape": {
    "radius": "4px",
    "radiusMax": "6px",
    "stroke": "1px",
    "shadow": "none"
  },
  "motion": {
    "default": "140ms ease",
    "vetoFlash": "220ms pulse opacity",
    "charts": "no bounce, no gradient fills"
  }
}
