# local env (the template stays tracked)
.env
.env.*
!.env.example

# python
*.egg-info/
*.log
*.py[cod]
.mypy_cache/
.pytest_cache/
.venv/
__pycache__/
build/
dist/
prosecutor.egg-info/

# runtime data: databases, live-loop state, plumbing runs
data/*.db
data/*.db-*
data/*.tmp
data/mock/
data/live_state.json
data/behavior_state.json
attacks/_generated/
backtest/_cache/

# The scenario bank and the model's cached answers are evidence, not runtime junk: the
# numbers in docs/RESULTS.md are only checkable if the setups they were measured on and
# the answers the model gave are both in the repo. They also let the attack suite be
# replayed without spending quota (run_attacks.py --cache-only).

# misc
.DS_Store
.streamlit/secrets.toml

# web
web/.vercel/
web/.vite/
web/dist/
web/node_modules/
web/public/live.json
